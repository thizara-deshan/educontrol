# /etc/eduscope/hw.env (mode 600) — created once by deploy/pi/install.sh from
# deploy/pi/env/hw.env.example; install.sh never changes it afterwards. Keys: services/hw/app/config.py.
HW_MODE=fake
# Per-module override (D-19). Each Hxx milestone switches its own module; H01: the ZS06 IR blaster,
# H03: the SNZB-02P climate sensor (H04: same module, also the SNZB-03P motion and SNZB-04PR2 door),
# H05: zigbee_status (coordinator, paired devices and permit joining from zigbee2mqtt),
# H06: audio and hdmi (the podium MCU: digipots and the HDMI switch, /dev/podium-mcu).
HW_DRIVERS=ir=real,sensors=real,zigbee_status=real,audio=real,hdmi=real
# H05: the SNZB-03P's "no motion" delay in seconds (5-60), set again after a re-pair. Default 15.
# HW_MOTION_TIMEOUT_S=15
# H06: the podium MCU's port (udev link from install.sh step 55).
# HW_PODIUM_PORT=/dev/podium-mcu
# H06: levels set after every MCU start (each hw-service start or reconnect resets the board), 0-100.
# HW_AUDIO_START_MIC=60
# HW_AUDIO_START_PC=40
# H06: which HDMI switch input (1 or 2) is the podium PC; the other is the smart board.
# HW_HDMI_PODIUM_PC_INPUT=1
# H06: digipot pair per channel (a = CS A, b = CS B in the firmware pin map).
# HW_PODIUM_PC_CH=a
# HW_PODIUM_MIC_CH=b
