    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
